# ==============================================================================
# Pedestrian Shield AI Backend Configuration
# ==============================================================================

# Server Network Configuration
HOST=0.0.0.0
PORT=8000
DEBUG=false
ALLOWED_ORIGINS=*

# Mode Selection: false for Real AI pipeline, true for Deterministic Mock Simulation
MOCK_MODE=false

# Computer Vision & Hazard Models
# Provider options: "local" (uses local PyTorch/Ultralytics weights) or "roboflow" (uses cloud-hosted YOLO API)
YOLO_PROVIDER=local
ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_VERSION=1
ROBOFLOW_CONFIDENCE=0.35
YOLO_MODEL_ENDPOINT=

# Local Model Weights (used when YOLO_PROVIDER=local)
MODEL_PATH=models/yolov8n.pt
CUSTOM_HAZARD_MODEL_PATH=models/potholes_curbs.pt
CONFIDENCE_THRESHOLD=0.35
PROCESSING_FPS=10
FRAME_QUEUE_MAXSIZE=1
STALE_FRAME_DROP_MS=250


# Walking Corridor Coordinates (Normalized 0.0 to 1.0)
WALKING_PATH_X=0.30
WALKING_PATH_Y=0.45
WALKING_PATH_WIDTH=0.40
WALKING_PATH_HEIGHT=0.55

# Temporal Tracking & Hazard Memory
TRACK_GRACE_PERIOD=1.5
TRACK_MAX_AGE_SECONDS=3.0
TRACK_IOU_THRESHOLD=0.3

# Alert Generation & Deduplication
ALERT_COOLDOWN_SECONDS=8.0
ALERT_FREQUENCY_DEFAULT=NORMAL
SENSITIVITY_DEFAULT=NORMAL

# Audio Processing
AUDIO_SAMPLE_RATE=16000
AUDIO_CONFIDENCE_THRESHOLD=0.75
AUDIO_ENERGY_THRESHOLD=0.015

# OCR Configuration
OCR_ENGINE=paddleocr
OCR_CONFIDENCE_THRESHOLD=0.60

# Conversational LLM (Fallback & Scene Explanations)
LLM_PROVIDER=rule_based
LLM_API_KEY=
LLM_MODEL=gemini-2.0-flash

# Database Persistence
DATABASE_URL=sqlite:///./data/pedestrian_safety.db

